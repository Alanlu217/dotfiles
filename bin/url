#!/usr/bin/env python3
import re
import subprocess
import sys


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <file>", file=sys.stderr)
        sys.exit(1)

    path = sys.argv[1]

    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            url = f.read()
    except OSError as e:
        print(f"Error reading {path}: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"Opening {url}")

    try:
        subprocess.Popen(
            ["firefox", url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        print("Firefox not found in PATH", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
