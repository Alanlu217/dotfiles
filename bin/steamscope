#!/usr/bin/env python3
import json
from subprocess import run
import os

desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()

if "hyprland" in desktop:
    msg = json.loads(
        run(["hyprctl", "monitors", "-j"], text=True, capture_output=True).stdout
    )
    output = next(o for o in msg if o["focused"])
    width = str(output["width"])
    height = str(output["height"])
    refresh = str(round(output["refreshRate"]))
else:
    msg = json.loads(
        run(["swaymsg", "-t", "get_outputs"], text=True, capture_output=True).stdout
    )
    output = next(o for o in msg if o["focused"])
    width = str(output["current_mode"]["width"])
    height = str(output["current_mode"]["height"])
    refresh = str(round(output["current_mode"]["refresh"] / 1000))

run(
    [
        "gamescope",
        "-e",
        "-W",
        width,
        "-H",
        height,
        "-f",
        "-r",
        refresh,
        "--steam",
        "--",
        "steam",
        "-tenfoot",
    ],
)
