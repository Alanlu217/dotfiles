#!/usr/bin/env python3
import os
import sys
import subprocess

import ctypes
import signal


def set_pdeathsig():
    libc = ctypes.CDLL("libc.so.6")
    PR_SET_PDEATHSIG = 1
    libc.prctl(PR_SET_PDEATHSIG, signal.SIGTERM)


def main():
    file = sys.argv[1] if len(sys.argv) > 1 else ""
    out = "/tmp/wtyp.pdf"

    if len(sys.argv) > 2:
        out = sys.argv[2]

    if not file:
        print("Expecting filename")
        sys.exit(1)

    if "." not in os.path.basename(file):
        file = file + ".typ"

    subprocess.run(["typst", "compile", file, out])

    subprocess.Popen(
        ["zathura", out],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    watch = subprocess.Popen(
        ["watchexec", "-c", "--", "typst", "compile", file, out],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        preexec_fn=set_pdeathsig,
    )

    editor = os.environ.get("EDITOR", "vi")
    subprocess.run([editor, file])

    watch.terminate()


if __name__ == "__main__":
    main()
