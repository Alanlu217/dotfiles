#!/usr/bin/env python3
"""Apply a unified diff from the Wayland clipboard.
 
Usage: apply-clip-patch [target-dir]   (default: ~/.config/hypr)
"""
import subprocess
import sys
import tempfile
from pathlib import Path
 
 
def die(msg: str) -> None:
    print(msg, file=sys.stderr)
    sys.exit(1)
 
 
def main() -> None:
    target = Path(sys.argv[1] if len(sys.argv) > 1 else "~/.config/hypr").expanduser()
    if not target.is_dir():
        die(f"Not a directory: {target}")
 
    clip = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True)
    if clip.returncode != 0:
        die(f"wl-paste failed: {clip.stderr.strip() or 'empty clipboard?'}")
 
    text = clip.stdout
    if not any(line.startswith("+++ ") for line in text.splitlines()):
        die("Clipboard doesn't look like a unified diff.")
    if not text.endswith("\n"):
        text += "\n"  # patch needs a trailing newline
 
    with tempfile.NamedTemporaryFile("w", suffix=".patch") as f:
        f.write(text)
        f.flush()
 
        def run_patch(*extra: str) -> int:
            return subprocess.run(
                ["patch", "-p1", "--forward", *extra, "-i", f.name], cwd=target
            ).returncode
 
        # Dry run first so a bad patch never half-applies.
        if run_patch("--dry-run") != 0:
            die(f"Patch does not apply cleanly in {target}; nothing changed.")
        if run_patch("--backup", "--suffix=.orig") != 0:
            die("patch failed unexpectedly.")
 
    print(f"Applied in {target} (originals saved as *.orig).")
 
 
if __name__ == "__main__":
    main()
 
